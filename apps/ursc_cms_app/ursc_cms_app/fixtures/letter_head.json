  "doctype": "Letter Head",
  "footer": "\n\n\n  <meta charset=\"UTF-8\">\n  <title>ISRO Letterhead - SRV RECEIPTS</title>\n  <style>\n    body {\n      font-family: 'DejaVu Sans', sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n\n    /* Letterhead Layout */\n    .letterhead {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 20px;\n      border-bottom: 2px solid #000;\n    }\n\n    .logo {\n      flex: 0 0 auto;\n    }\n\n    .logo img {\n      height: 70px;\n      width: auto;\n    }\n\n    .titles {\n      flex: 1;\n      padding-left: 20px;\n      text-align: left;\n    }\n\n    .titles .title {\n      font-size: 16px;\n      font-weight: bold;\n      line-height: 1.4;\n    }\n\n    /* SRV RECEIPTS Heading */\n    .main-heading {\n      text-align: center;\n      font-size: 22px;\n      font-weight: bold;\n      margin: 20px 0;\n    }\n\n    /* Table Styling */\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      table-layout: fixed;\n      margin: 20px;\n    }\n\n    th, td {\n      border: 1px solid black;\n      padding: 6px;\n      font-size: 12px;\n      word-wrap: break-word;\n      white-space: normal;\n      overflow-wrap: break-word;\n      max-width: 150px;\n      text-align: left;\n    }\n\n    /* Footer Styling */\n    .footer {\n      position: fixed;\n      bottom: 10px;\n      width: 100%;\n      text-align: center;\n      font-size: 12px;\n      color: gray;\n    }\n\n    @media print {\n      th, td {\n        font-size: 10px !important;\n      }\n\n      @page {\n        size: A4 landscape;\n        margin: 10mm;\n      }\n    }\n  </style>\n\n\n\n\n  <!-- Letterhead -->\n  <div class=\"letterhead\">\n    <div class=\"logo\">\n      <img src=\"/files/logo1.png\" alt=\"Logo Left\">\n    </div>\n    <div class=\"titles\">\n      <div class=\"title\">\n        EEE Components Storage and Management System<br>\n        U R Rao Satellite Centre (URSC)<br>\n        Old Airport Road, Vimanapura Post,<br>\n        Bengaluru - 560017\n      </div>\n    </div>\n  </div>\n\n  <!-- Main Heading -->\n  <div class=\"main-heading\">SRV RECEIPTS</div>\n\n  <!-- Example Table -->\n  <table>\n    <thead>\n      <tr>\n        <th>Item Code</th>\n        <th>Item Name</th>\n        <th>UOM</th>\n        <th>Qty</th>\n        <th>Rate</th>\n        <th>Amount</th>\n        <th>Remarks</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>IC1234</td>\n        <td>Capacitor 10uF</td>\n        <td>Nos</td>\n        <td>500</td>\n        <td>5</td>\n        <td>2500</td>\n        <td>Approved</td>\n      </tr>\n      <!-- Add more rows dynamically or via templating engine -->\n    </tbody>\n  </table>\n\n  <!-- Footer -->\n  <div class=\"footer\">\n    ISRO URSC © 2025 | Internal Use Only\n  </div>\n\n\n\n",
