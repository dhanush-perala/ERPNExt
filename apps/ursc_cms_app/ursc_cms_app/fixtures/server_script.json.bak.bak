  "doctype_event": "After Submit",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-08-08 15:07:13.923871",
  "module": "ISRO CMS",
  "name": "srv post",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV_POST",
  "script": "# Ensure 'doc' is the current document being submitted\n# and that 'SRV Binning' exists before creating it\nif frappe.db.exists(\"DocType\", \"SRV Binning\"):\n    # Create a new SRV Binning document\n    new_doc = frappe.new_doc(\"SRV Binning\")\n\n    # Map fields from SRV_POST to SRV_Binning\n    new_doc.srv_no = doc.srv_no\n    new_doc.srv_date = doc.srv_date\n    new_doc.project = doc.project\n    new_doc.inword_no = doc.inword_no\n    new_doc.po_no = doc.po_no\n    new_doc.po_date = doc.po_date\n    new_doc.supplier = doc.supplier\n    new_doc.store = doc.store\n\n    # Insert the new record\n    new_doc.insert(ignore_permissions=True)\n\n    # Redirect user to the new SRV Binning record\n    frappe.response[\"type\"] = \"redirect\"\n    frappe.response[\"location\"] = f\"/app/srv-binning/{new_doc.name}\"\nelse:\n    frappe.throw(\n        \"DocType 'SRV Binning' is missing. Please create it before submitting this document.\"\n    )\n",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 1,
  "api_method": "send_all_queued_emails_now",
  "cron_format": null,
  "disabled": 1,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "Daily",
  "modified": "2025-08-06 16:12:04.138006",
  "module": null,
  "name": "send_all_queued_emails_now",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "def send_all_queued_emails_now():\n    # Get all pending (not sent) emails from Email Queue\n    queued_emails = frappe.get_all(\"Email Queue\", filters={\"status\": \"Not Sent\"}, fields=[\"name\"], limit=100)\n\n    if not queued_emails:\n        return \"✅ No pending emails found in Email Queue.\"\n\n    success = 0\n    failed = []\n\n    for email in queued_emails:\n        try:\n            send_now(email.name)  # This uses stored recipients in the Email Queue record\n            success += 1\n        except Exception as e:\n            failed.append(f\"{email.name}: {str(e)}\")\n            frappe.log_error(f\"Failed to send queued email {email.name}\", str(e))\n\n    return {\n        \"status\": \"completed\",\n        \"emails_sent\": success,\n        \"emails_failed\": len(failed),\n        \"failures\": failed\n    }\n",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "project_subsystem_api",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-07-25 14:11:48.998963",
  "module": "ISRO CMS",
  "name": "ADD PROJECT SUBSYSTEM",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "ADD PROJECT SUBSYSTEM",
  "script": "try:\n    data = frappe.get_all(\n        \"ADD PROJECT CARD\",\n        filters={\"project_status\": \"ONGOING\"},\n        fields=[\"project\"]\n    )\n    unique_projects = sorted(set(d[\"project\"] for d in data if d.get(\"project\")))\n    frappe.response[\"message\"] = [{\"project\": p} for p in unique_projects]\nexcept Exception as e:\n    frappe.log_error(frappe.get_traceback(), \"Error in get_project_list\")\n    frappe.response[\"message\"] = {\"error\": str(e)}\n\n \nif frappe.request.method == \"POST\":\n    data = frappe.request.get_json()\n\n    # Create\n    if data.get(\"action\") == \"create\":\n        doc = frappe.get_doc({\n            \"doctype\": \"ADD PROJECT SUBSYSTEM\",\n            \"project\": data.get(\"project\"),\n            \"sub_system\": data.get(\"sub_system\"),\n            \"centre\": data.get(\"centre\"),\n        })\n        doc.insert(ignore_permissions=True)\n        frappe.response[\"message\"] = {\"status\": \"success\", \"msg\": \"Saved successfully\"}\n\n    # Read\n    elif data.get(\"action\") == \"read\":\n        records = frappe.get_all(\"ADD PROJECT SUBSYSTEM\", \n            fields=[\"name\", \"project\", \"sub_system\", \"centre\"],\n            order_by=\"creation desc\")\n        frappe.response[\"message\"] = {\"status\": \"success\", \"records\": records}\n\n    # Delete\n    elif data.get(\"action\") == \"delete\":\n        name = data.get(\"name\")\n        if name:\n            try:\n                frappe.delete_doc(\"ADD PROJECT SUBSYSTEM\", name, ignore_permissions=True)\n                frappe.response[\"message\"] = {\"status\": \"success\", \"msg\": \"Deleted successfully\"}\n            except Exception as e:\n                frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": str(e)}\n        else:\n            frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": \"Missing document name for delete\"}\n\n    # Update\n    elif data.get(\"action\") == \"update\":\n        name = data.get(\"name\")\n        if name:\n            try:\n                doc = frappe.get_doc(\"ADD PROJECT SUBSYSTEM\", name)\n                doc.project = data.get(\"project\")\n                doc.sub_system = data.get(\"sub_system\")\n                doc.centre = data.get(\"centre\")\n                doc.save(ignore_permissions=True)\n                frappe.response[\"message\"] = {\"status\": \"success\", \"msg\": \"Updated successfully\"}\n            except Exception as e:\n                frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": str(e)}\n        else:\n            frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": \"Missing document name for update\"}\n",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "add_project_card_api",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-07-24 17:57:19.742751",
  "module": "ISRO CMS",
  "name": "AddProjectcard",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "\n\nif frappe.request.method == \"POST\":\n    data = frappe.request.get_json()\n\n    # Create\n    if data.get(\"action\") == \"create\":\n        doc = frappe.get_doc({\n            \"doctype\": \"ADD PROJECT CARD\",\n            \"project\": data.get(\"project\"),\n            \"prog_name\": data.get(\"prog_name\"),\n            \"project_ref_no\": data.get(\"project_ref_no\"),\n            \"pd_staff_no\": data.get(\"pd_staff_no\"),\n            \"project_status\": data.get(\"project_status\")\n        })\n        doc.insert(ignore_permissions=True)\n        frappe.response[\"message\"] = {\"status\": \"success\", \"msg\": \"Saved successfully\"}\n\n    # Read\n    elif data.get(\"action\") == \"read\":\n        records = frappe.get_all(\"ADD PROJECT CARD\", \n            fields=[\"name\", \"project\", \"prog_name\", \"project_ref_no\", \"pd_staff_no\", \"project_status\"],\n            order_by=\"creation desc\")\n        frappe.response[\"message\"] = {\"status\": \"success\", \"records\": records}\n\n    # Delete\n    elif data.get(\"action\") == \"delete\":\n        name = data.get(\"name\")\n        if name:\n            try:\n                frappe.delete_doc(\"ADD PROJECT CARD\", name, ignore_permissions=True)\n                frappe.response[\"message\"] = {\"status\": \"success\", \"msg\": \"Deleted successfully\"}\n            except Exception as e:\n                frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": str(e)}\n        else:\n            frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": \"Missing document name for delete\"}\n\n    # Update\n    elif data.get(\"action\") == \"update\":\n        name = data.get(\"name\")\n        if name:\n            try:\n                doc = frappe.get_doc(\"ADD PROJECT CARD\", name)\n                doc.project = data.get(\"project\")\n                doc.prog_name = data.get(\"prog_name\")\n                doc.project_ref_no = data.get(\"project_ref_no\")\n                doc.pd_staff_no = data.get(\"pd_staff_no\")\n                doc.project_status = data.get(\"project_status\")\n                doc.save(ignore_permissions=True)\n                frappe.response[\"message\"] = {\"status\": \"success\", \"msg\": \"Updated successfully\"}\n            except Exception as e:\n                frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": str(e)}\n        else:\n            frappe.response[\"message\"] = {\"status\": \"error\", \"msg\": \"Missing document name for update\"}\n",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "insert_basic_mdb",
