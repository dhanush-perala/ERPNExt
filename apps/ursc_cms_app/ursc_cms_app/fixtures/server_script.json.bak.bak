  "modified": "2025-07-16 11:25:40.009912",
  "module": "ISRO CMS",
  "name": "update_mdb server script",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "data = frappe.form_dict\n\ndoc = frappe.get_doc(\"BASIC MDB\", data.get(\"name\"))\ndoc.basic_mdb_id = data.get(\"basic_mdb_id\")\ndoc.comp_id = data.get(\"comp_id\")\ndoc.basic_mdb = data.get(\"basic_mdb\")\ndoc.link_id = data.get(\"link_id\")\ndoc.mdb_status = data.get(\"mdb_status\")\ndoc.restrict_opt = data.get(\"restrict_opt\")\n\ndoc.save(ignore_permissions=True)\n\nfrappe.response[\"message\"] = {\n    \"status\": \"success\",\n    \"message\": f\"{doc.name} updated successfully!\"\n}\n",
  "script_type": "API"
 },
 {
