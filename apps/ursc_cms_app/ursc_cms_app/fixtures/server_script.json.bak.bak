  "modified": "2025-08-28 19:08:26.460142",
  "module": "ISRO CMS",
  "name": "PROJECT_MASTER when we change status",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "PROJECT_MASTER",
  "script": "# Server Script for DocType: PROJECT_MASTER\n# Event: After Save\n# Type: Python\n\n# Only reset status if the document is being edited manually (not via approval)\nif not frappe.flags.from_approval:\n    doc.work_flow_status = \"Pending for Approve\"\n\n    # Update linked PROJECT MASTER APPROVE records\n    approve_records = frappe.get_all(\n        'PROJECT MASTER APPROVE',\n        filters={'select_project': doc.name},\n        fields=['name']\n    )\n\n    for rec in approve_records:\n        # Correct usage of set_value in Server Script\n        frappe.db.set_value('PROJECT MASTER APPROVE', rec.name, 'status', 'Inactive')\n",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 1,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "After Save",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-08-28 17:57:05.772440",
  "module": "ISRO CMS",
  "name": "PROJECT MASTER APPROVE ONE TIME SAVE ONLY",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "PROJECT MASTER APPROVE",
  "script": "# Server Script for DocType: PROJECT MASTER APPROVE\n# Event: Before Save\n# Type: Python\n\n# Only allow status change if the current status is not already Approve or Reject\nif doc.work_flow_status in [\"Approve\", \"Reject\"] and not doc.get(\"__islocal\"):\n    # If the record is being updated again\n    old_doc = frappe.get_doc(\"PROJECT MASTER APPROVE\", doc.name)\n    if old_doc.work_flow_status in [\"Approve\", \"Reject\"]:\n        frappe.throw(\"This record has already been approved or rejected. Status cannot be changed again.\")\n",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Save",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-08-29 11:28:33.560609",
  "module": "ISRO CMS",
  "name": "srv post validaition for posted qty",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV_POST",
  "script": "# SRV_POST → Before Save (NO imports, NO += / -=)\n \n# 0) Require SRV reference (srv_no preferred, else srv_original)\n\nsrv_ref = doc.get(\"srv_no\") or doc.get(\"srv_original\")\n\nif not srv_ref:\n\n    frappe.throw(\"SRV reference is required ).\")#on SRV_POST (srv_no or srv_original).\")\n \n# 1) Sum current form posted qty (guard negatives)\n\ncur_total = 0.0\n\nfor r in (doc.table_kyqc or []):\n\n    qty = frappe.utils.flt(r.posted_quantity)\n\n    if qty < 0:\n\n        frappe.throw(\"Row \" + str(r.idx) + \": posted_quantity cannot be negative.\")\n\n    cur_total = cur_total + qty\n \n# 2) Sum OTHER SRV_POST RE rows for this SRV (exclude this doc if updating)\n\n#    NOTE: Query is keyed by p.srv_original. If your site uses p.srv_no instead, change WHERE accordingly.\n\nparams = [doc.get(\"srv_original\") or doc.get(\"srv_no\")]\n\nexclude_sql = \"\"\n\nif not doc.is_new():\n\n    exclude_sql = \" AND p.name != %s\"\n\n    params.append(doc.name)\n \nres = frappe.db.sql(\"\"\"\n\n    SELECT COALESCE(SUM(t.posted_quantity), 0)\n\n    FROM `tabSRV POST RE` t\n\n    INNER JOIN `tabSRV_POST` p ON p.name = t.parent\n\n    WHERE p.srv_original = %s\n\n      AND p.docstatus != 2\n\n\"\"\" + exclude_sql, tuple(params))\n\nother_total = res[0][0] if res else 0.0\n \nplanned_total = frappe.utils.flt(other_total) + frappe.utils.flt(cur_total)\n \n# 3) Get & lock SRV ENTRY (prefer srv_no Link; else map srv_original -> SRV ENTRY by its srv_no field)\n\nentry_name = None\n\nif doc.get(\"srv_no\"):\n\n    entry_name = doc.get(\"srv_no\")\n\nelse:\n\n    entry_name = frappe.db.get_value(\"SRV ENTRY\", {\"srv_no\": doc.get(\"srv_original\")}, \"name\")\n \nif not entry_name:\n\n    frappe.throw(\"No SRV ENTRY found for SRV \" + str(srv_ref))\n \n# Lock parent row to serialize FIFO recompute\n\nfrappe.db.sql(\"SELECT name FROM `tabSRV ENTRY` WHERE name=%s FOR UPDATE\", (entry_name,))\n\nentry = frappe.get_doc(\"SRV ENTRY\", entry_name)\n \n# 4) Capacity = sum(rec_qty) and cap check\n\ncapacity = 0.0\n\nfor rw in (entry.table_vuja or []):\n\n    capacity = capacity + frappe.utils.flt(rw.rec_qty)\n \nif planned_total > capacity:\n\n    over = planned_total - capacity\n\n    frappe.throw(\n\n        \"Cannot post: total posted (\" + str(planned_total) + \") would exceed received (\"\n\n        + str(capacity) + \") by \" + str(over) + \" for SRV \" + str(srv_ref) + \".\"\n\n    )\n \n# 5) Ensure 'postedqty' field exists on SRV ENT TABLE\n\nchild_meta = frappe.get_meta(\"SRV ENT TABLE\")\n\nif not child_meta.get_field(\"postedqty\"):\n\n    frappe.throw(\"Field 'postedqty' (Float) is missing on child doctype 'SRV ENT TABLE'.\")\n \n# 6) FIFO allocate cumulative posted → postedqty, persist each child row\n\nremaining = planned_total\n\nfor rw in (entry.table_vuja or []):\n\n    if remaining <= 0:\n\n        alloc = 0.0\n\n    else:\n\n        row_cap = frappe.utils.flt(rw.rec_qty)\n\n        if row_cap < remaining:\n\n            alloc = row_cap\n\n        else:\n\n            alloc = remaining\n\n    remaining = remaining - alloc\n \n    # Persist to child row directly (works even if parent is Submitted)\n\n    frappe.db.set_value(\"SRV ENT TABLE\", rw.name, \"postedqty\", alloc)\n\n ",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "After Save",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-08-07 14:56:39.066118",
  "module": "ISRO CMS",
  "name": "SAMPLE DATA SRV ENTRY SAVE",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV ENTRY FORM",
  "script": "# Trigger: After Save on SRV ENTRY\n\n# 1. Check if a copy already exists by matching source_doc with current doc.name\nsrv_copy_name = frappe.db.get_value(\"SRV ENTRY COPY\", {\"source_doc\": doc.name})\n#means field in copied doc,where it stores the name of original doctype\n# 2. If exists, load it; otherwise, create new\nif srv_copy_name:\n    srv_copy = frappe.get_doc(\"SRV ENTRY COPY\", srv_copy_name)\nelse:\n    srv_copy = frappe.new_doc(\"SRV ENTRY COPY\")\n    srv_copy.source_doc = doc.name  # This is just a Data field\n\n# 3. Copy parent fields\nsrv_copy.inward_no = doc.inward_no\nsrv_copy.srv_no = doc.srv_no\nsrv_copy.srv_date = doc.srv_date\nsrv_copy.project = doc.project\nsrv_copy.po_no = doc.po_no\nsrv_copy.po_date = doc.po_date\nsrv_copy.supplier = doc.supplier\n\n# 4. Clear and re-copy child table rows\nsrv_copy.set(\"srv_ent_copy\", [])\n\nfor row in doc.table_vuja:\n    srv_copy.append(\"srv_ent_copy\", {\n        \"comp_type\": row.comp_type,\n        \"srv_part_no\": row.srv_part_no,\n        \"rec_qty\": row.rec_qty,\n        \"odered_qty\": row.odered_qty,\n        \"u_cost\": row.u_cost,\n        \"ret_qty\": row.ret_qty\n    })\n\n# 5. Save\nsrv_copy.save(ignore_permissions=True)\n",
  "script_type": "DocType Event"
 },
