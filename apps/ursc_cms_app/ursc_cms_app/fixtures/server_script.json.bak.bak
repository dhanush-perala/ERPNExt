  "script": "frappe.response[\"message\"] = {\n    \"mdb_status_options\": [\"valid\", \"invalid\"],\n    \"restrict_opt_options\": [\"RESTRICT\", \"Not RESTRICT\"]\n}\n# need place with orginal doc type with options",
  "script_type": "API"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Save",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-08-28 16:43:46.106611",
  "module": "ISRO CMS",
  "name": "SRV ENTRY REC QTY DECREASE BY SRV BIN",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV BINNING",
  "script": "# Enforce at binning time:\n# 1) Sum of all SRV BIN TABLE.posted_quantity for this SRV (saved + current form)\n#    must be <= SRV ENTRY total received (sum of SRV ENT TABLE.rec_qty).\n# 2) If SRV_POST / SRV POST RE exist, also cap by their total posted_quantity.\n# 3) Recompute SRV ENTRY.child.binqty by FIFO from planned_total.\n\n# Names you provided:\n# SRV ENTRY (parent): \"SRV ENTRY\"  -> link key: srv_no\n#   - child table field: table_vuja (child doctype: \"SRV ENT TABLE\")\n#   - child fields: rec_qty, binqty\n#\n# SRV BINNING (parent): \"SRV BINNING\" -> link key to entry: srv_post_no\n#   - child table field: table_iuyx (child doctype: \"SRV BIN TABLE\")\n#   - child field: posted_quantity  (read-only from SRV POST RE)\n#\n# SRV POST (parent): \"SRV_POST\" -> link key: srv_original\n#   - child table field: table_kyqc (child doctype: \"SRV POST RE\")\n#   - child field on SRV POST RE: posted_quantity\n\n# 0) Require SRV number\nif not doc.srv_post_no:\n    frappe.throw(\"SRV Post No (srv_post_no) is required on SRV BINNING.\")\n\n# 1) Current form total (sum posted_quantity on this BINNING form)\ncur_total = 0.0\nfor r in (doc.table_iuyx or []):\n    cur_total = cur_total + frappe.utils.flt(r.posted_quantity)\n\n# 2) Sum of OTHER (saved, not cancelled) BINNING rows for same SRV\nparams = [doc.srv_post_no]\nexclude_sql = \"\"\nif not doc.is_new():\n    exclude_sql = \" and pb.name != %s\"\n    params.append(doc.name)\n\nother_rows = frappe.db.sql(\"\"\"\n    select coalesce(sum(b.posted_quantity), 0)\n    from `tabSRV BIN TABLE` b\n    inner join `tabSRV BINNING` pb on pb.name = b.parent\n    where pb.srv_post_no = %s and pb.docstatus != 2\n      and b.parenttype = 'SRV BINNING' and b.parentfield = 'table_iuyx'\"\"\" + exclude_sql, tuple(params))\n\nother_total = other_rows[0][0] if other_rows else 0.0\nplanned_total = frappe.utils.flt(other_total) + frappe.utils.flt(cur_total)\n\n# 3) Optional SRV_POST cap (skip cleanly if those doctypes don't exist here)\npost_limit = None\ntry:\n    lim_rows = frappe.db.sql(\"\"\"\n        select coalesce(sum(t.posted_quantity),0)\n        from `tabSRV POST RE` t\n        inner join `tabSRV_POST` p on p.name = t.parent\n        where p.srv_original = %s and p.docstatus != 2\n    \"\"\", (doc.srv_post_no,))\n    post_limit = lim_rows[0][0] if lim_rows else 0.0\nexcept Exception:\n    post_limit = None\n\nif post_limit is not None and planned_total > frappe.utils.flt(post_limit):\n    diff = planned_total - frappe.utils.flt(post_limit)\n    frappe.throw(\n        \"Cannot bin: total binned (\" + str(planned_total) + \") would exceed SRV POST posted qty (\"\n        + str(post_limit) + \") by \" + str(diff) + \" for SRV \" + str(doc.srv_post_no) + \".\"\n    )\n\n# 4) Fetch & lock SRV ENTRY for this SRV\nentry_name = frappe.db.get_value(\"SRV ENTRY\", {\"srv_no\": doc.srv_post_no}, \"name\")\nif not entry_name:\n    frappe.throw(\"No SRV ENTRY found with srv_no = \" + str(doc.srv_post_no))\n\nfrappe.db.sql(\"select name from `tabSRV ENTRY` where name=%s for update\", (entry_name,))\nentry = frappe.get_doc(\"SRV ENTRY\", entry_name)\n\n# 5) Capacity = sum of rec_qty on SRV ENTRY child\ncapacity = 0.0\nfor rw in (entry.table_vuja or []):\n    capacity = capacity + frappe.utils.flt(rw.rec_qty)\n\n# Stop if planned > capacity; info if exactly full\nif planned_total > capacity:\n    over = planned_total - capacity\n    frappe.throw(\n        \"Cannot bin: total binned (\" + str(planned_total) + \") would exceed received (\"\n        + str(capacity) + \") by \" + str(over) + \" for SRV \" + str(doc.srv_post_no) + \".\"\n    )\nelif planned_total == capacity:\n    frappe.msgprint(\"All received components are fully binned for SRV NUMBER \" + str(doc.srv_post_no) + \".\")\n\n# 6) Recompute ENTRY.binqty by FIFO from planned_total (each row capped by its rec_qty)\nremaining = planned_total\n\n# reset binqty first\nfor rw in (entry.table_vuja or []):\n    rw.binqty = 0.0\n\nfor rw in (entry.table_vuja or []):\n    if remaining <= 0.0:\n        break\n    row_cap = frappe.utils.flt(rw.rec_qty)\n    alloc = row_cap if row_cap < remaining else remaining\n    rw.binqty = alloc\n    remaining = remaining - alloc\n\n# 7) Save ENTRY (even if submitted) + audit note\nentry.flags.ignore_validate_update_after_submit = True\nentry.save(ignore_permissions=True)\nentry.add_comment(\n    \"Info\",\n    \"SRV BINNING \" + str(doc.name) + \": planned_total=\" + str(planned_total)\n    + \", capacity=\" + str(capacity)\n    + ((\"; SRV POST cap=\" + str(post_limit)) if post_limit is not None else \"\")\n)\n",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "After Save",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-08-28 17:44:05.665667",
  "module": "ISRO CMS",
  "name": "SRV BINNING AFTER SAVE SRV_STATUS CHANGE",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV BINNING",
  "script": "# Server Script: SRV BINNING → After Save\n# Purpose: when fully binned, set srv_status=1 on SRV ENTRY & SRV_POST\n#          and make SRV ENTRY non-editable by submitting it (docstatus=1).\n\n# Find the linked SRV ENTRY by SRV number\nentry_name = frappe.db.get_value(\"SRV ENTRY\", {\"srv_no\": doc.srv_post_no}, \"name\")\nif entry_name:\n    entry = frappe.get_doc(\"SRV ENTRY\", entry_name)\n\n    # Calculate total posted qty (current form + other saved bins)\n    cur_total = 0.0\n    for r in (doc.table_iuyx or []):\n        cur_total = cur_total + frappe.utils.flt(r.posted_quantity)\n\n    params = [doc.srv_post_no]\n    exclude_sql = \"\"\n    if not doc.is_new():\n        exclude_sql = \" and pb.name != %s\"\n        params.append(doc.name)\n\n    other_rows = frappe.db.sql(\"\"\"\n        select coalesce(sum(b.posted_quantity), 0)\n        from `tabSRV BIN TABLE` b\n        inner join `tabSRV BINNING` pb on pb.name = b.parent\n        where pb.srv_post_no = %s and pb.docstatus != 2\n          and b.parenttype = 'SRV BINNING' and b.parentfield = 'table_iuyx'\"\"\" + exclude_sql, tuple(params))\n    other_total = other_rows[0][0] if other_rows else 0.0\n\n    planned_total = frappe.utils.flt(other_total) + frappe.utils.flt(cur_total)\n\n    # Capacity from SRV ENTRY child rows\n    capacity = 0.0\n    for rw in (entry.table_vuja or []):\n        capacity = capacity + frappe.utils.flt(rw.rec_qty)\n\n    # Only flip status when fully binned\n    if planned_total == capacity:\n        # 1) SRV ENTRY.srv_status = 1\n        frappe.db.set_value(\"SRV ENTRY\", entry.name, \"srv_status\", 1, update_modified=False)\n\n        # 1a) Submit SRV ENTRY (read-only). Prefer proper submit; fallback to docstatus=1.\n        try:\n            entry.reload()\n            # If the doctype is submittable and still draft, submit it\n            is_submittable = 0\n            try:\n                # meta may not expose attr in safe_exec unless accessed this way\n                is_submittable = 1 if entry.meta.is_submittable else 0\n            except Exception:\n                is_submittable = 0\n\n            if entry.docstatus == 0:\n                if is_submittable:\n                    entry.flags.ignore_permissions = True\n                    entry.submit()  # sets docstatus = 1, creates Submit Version, runs hooks\n                else:\n                    # Fallback: hard-set docstatus to 1 (use only if your flow expects it)\n                    frappe.db.set_value(\"SRV ENTRY\", entry.name, \"docstatus\", 1, update_modified=False)\n        except Exception:\n            frappe.log_error(frappe.get_traceback(), \"SRV ENTRY submit on fully binned failed\")\n\n        # 2) SRV_POST.srv_status = 1 (linkage: srv_original == SRV ENTRY.srv_no)\n        srv_num = entry.srv_no or doc.srv_post_no\n        post_names = frappe.get_all(\n            \"SRV_POST\",\n            filters={\"docstatus\": [\"!=\", 2], \"srv_original\": srv_num},\n            pluck=\"name\",\n        )\n        for nm in post_names:\n            frappe.db.set_value(\"SRV_POST\", nm, \"srv_status\", 1, update_modified=False)\n",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Delete",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2025-09-08 16:31:14.319370",
  "module": "ISRO CMS",
  "name": "SRV BINNING inactive data",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV BINNING",
  "script": "import frappe\n\ndef before_delete(doc, method=None):\n    if not doc.srv_no:\n        return\n\n    posts = frappe.get_all(\"SRV_POSTSRV_POST\", filters={\"srv_no\": doc.srv_no}, pluck=\"name\")\n    for name in posts:\n        try:\n            sp = frappe.get_doc(\"SRV_POST\", name)\n            if sp.docstatus == 1:\n                sp.cancel()\n            sp.delete()\n        except Exception as e:\n            frappe.log_error(frappe.get_traceback(), \"SRV_POST Delete Failed\")\n",
  "script_type": "DocType Event"
 }
]