  "modified": "2025-08-14 16:39:24.957575",
  "module": "ISRO CMS",
  "name": "SRV ENTRY DUPLICATE FOR CHILD FETCH",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": "SRV ENTRY",
  "script": "# Trigger: After Save on SRV ENTRY\n\n# 1. Check if a copy already exists by matching source_doc with current doc.name\nsrv_copy_name = frappe.db.get_value(\"SRV ENTRY DUPLICATE FOR CHILD TABLE FETCHING\", {\"source_doc\": doc.name})\n#means field in copied doc,where it stores the name of original doctype\n# 2. If exists, load it; otherwise, create new\nif srv_copy_name:\n    srv_copy = frappe.get_doc(\"SRV ENTRY DUPLICATE FOR CHILD TABLE FETCHING\", srv_copy_name)\nelse:\n    srv_copy = frappe.new_doc(\"SRV ENTRY DUPLICATE FOR CHILD TABLE FETCHING\")\n    srv_copy.source_doc = doc.name  # This is just a Data field\n\n# 3. Copy parent fields\nsrv_copy.inward_no = doc.inward_no\nsrv_copy.srv_no = doc.srv_no\nsrv_copy.srv_date = doc.srv_date\nsrv_copy.project = doc.project\nsrv_copy.po_no = doc.po_no\nsrv_copy.po_date = doc.po_date\nsrv_copy.supplier = doc.supplier\n\n# 4. Clear and re-copy child table rows\nsrv_copy.set(\"table_child\", [])\n\nfor row in doc.table_vuja:\n    srv_copy.append(\"table_child\", {\n        \"comp_type\": row.comp_type,\n        \"srv_part_no\": row.srv_part_no,\n        \"rec_qty\": row.rec_qty,\n        \"odered_qty\": row.odered_qty,\n        \"u_cost\": row.u_cost,\n        \"ret_qty\": row.ret_qty,\n        \"srv_no\":row.srv_no\n    })\n\n# 5. Save\nsrv_copy.save(ignore_permissions=True)\n",
  "script_type": "DocType Event"
 },
 {
  "allow_guest": 0,
  "api_method": null,
  "cron_format": null,
  "disabled": 1,
  "docstatus": 0,
