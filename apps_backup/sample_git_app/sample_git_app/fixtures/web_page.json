  "main_section_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Sample Website</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n  <header>\n    <h1>My Website</h1>\n    <nav>\n      <ul class=\"navbar\">\n        <li><a href=\"#\">Home</a></li>\n        <li><a href=\"#\">About</a></li>\n        <li><a href=\"#\">Projects</a></li>\n        <li><a href=\"#\">Contact</a></li>\n      </ul>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"intro\">\n      <h2>Welcome!</h2>\n      <p>This is a simple responsive HTML + CSS layout for learning and customizing.</p>\n    </section>\n\n    <section class=\"cards\">\n      <div class=\"card\">\n        <h3>Card 1</h3>\n        <p>This is some sample content inside a card.</p>\n      </div>\n      <div class=\"card\">\n        <h3>Card 2</h3>\n        <p>Another card with some other sample content.</p>\n      </div>\n      <div class=\"card\">\n        <h3>Card 3</h3>\n        <p>Cards are great for organizing content in blocks.</p>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <p>&copy; 2025 My Website. All rights reserved.</p>\n  </footer>\n</body>\n</html>\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: \"Segoe UI\", Tahoma, Geneva, Verdana, sans-serif;\n  line-height: 1.6;\n  background-color: #f4f4f4;\n  color: #333;\n}\n\nheader {\n  background-color: #333;\n  color: white;\n  padding: 1rem 0;\n  text-align: center;\n}\n\n.navbar {\n  list-style: none;\n  display: flex;\n  justify-content: center;\n  margin-top: 0.5rem;\n}\n\n.navbar li {\n  margin: 0 15px;\n}\n\n.navbar a {\n  color: white;\n  text-decoration: none;\n  font-weight: bold;\n}\n\n.navbar a:hover {\n  text-decoration: underline;\n}\n\nmain {\n  padding: 2rem;\n}\n\n.intro {\n  text-align: center;\n  margin-bottom: 2rem;\n}\n\n.cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 1.5rem;\n}\n\n.card {\n  background-color: white;\n  padding: 1rem;\n  border-radius: 8px;\n  box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);\n}\n\nfooter {\n  text-align: center;\n  background-color: #333;\n  color: white;\n  padding: 1rem 0;\n  margin-top: 2rem;\n}\n",
